            <h2><?= $escaper->escapeHtml(__('Asyntai is now enabled')) ?></h2>
            <p class="asyntai-connected-text">
                <?= $escaper->escapeHtml(__('Set up your AI chatbot, review chat logs and more:')) ?>
            </p>
            <a class="action-primary" href="https://asyntai.com/dashboard" target="_blank" rel="noopener">
                <?= $escaper->escapeHtml(__('Open Asyntai Panel')) ?>
            </a>
            <p style="margin:20px 0 0;color:#666;">
                <?php if ($catalogStatus === 'connected'): ?>
                    <?= $escaper->escapeHtml(
                        __('Live prices and stock are on. The assistant reads them from your catalogue.')
                    ) ?>
                <?php elseif ($catalogStatus === 'unavailable'): ?>
                    <?= $escaper->escapeHtml(
                        __('The assistant answers from your pages. It is not reading live prices and stock.')
                    ) ?>
                <?php endif; ?>
            </p>
            <p style="margin:20px 0 0;color:#666;">
                <strong><?= $escaper->escapeHtml(__('Tip:')) ?></strong>
                <?= $escaper->escapeHtml(__('If you want to change how the AI answers, please')) ?>
                <a href="https://asyntai.com/dashboard#setup" target="_blank" rel="noopener"
                   style="color:#2563eb;text-decoration:underline;">
                    <?= $escaper->escapeHtml(__('go here')) ?>
                </a>.
            </p>
        </div>
    </div>

    <div id="asyntai-popup-wrap" style="display:<?= $siteId ? 'none' : 'block' ?>;">
