            prepareUrl: '<?= $escaper->escapeJs($block->getUrl('asyntai/api/prepare')) ?>',
            pollUrl: '<?= $escaper->escapeJs($block->getUrl('asyntai/api/poll')) ?>',
            formKey: '<?= $escaper->escapeJs($block->getFormKey()) ?>'
        });
    });
</script>
