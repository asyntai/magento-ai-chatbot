$config = $block->getConfig();
$siteId = $config->getSiteId();
$accountEmail = $config->getAccountEmail();
$catalogStatus = $config->getCatalogStatus();
?>

<div id="asyntai-settings-wrap">
    <h1><?= $escaper->escapeHtml(__('Asyntai AI Chatbot')) ?></h1>

    <p id="asyntai-status">
        <?= $escaper->escapeHtml(__('Status:')) ?>
        <span style="color:<?= $siteId ? '#28a745' : '#dc3545' ?>;font-weight:600;">
            <?= $escaper->escapeHtml($siteId ? __('Connected') : __('Not connected')) ?>
        </span>
        <?php if ($siteId && $accountEmail): ?>
            <?= $escaper->escapeHtml(__('as')) ?> <?= $escaper->escapeHtml($accountEmail) ?>
        <?php endif; ?>
        <?php if ($siteId): ?>
            <button type="button" id="asyntai-reset" class="action-default" style="margin-left: 12px;">
                <?= $escaper->escapeHtml(__('Reset')) ?>
            </button>
        <?php endif; ?>
    </p>

    <div id="asyntai-alert" style="display:none;"></div>

    <div id="asyntai-connected-box" style="display:<?= $siteId ? 'block' : 'none' ?>;">
