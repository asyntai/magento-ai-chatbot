                    <?= $escaper->escapeHtml(__('Also let the assistant look up orders for a customer')) ?>
                </label>
            </p>
            <p style="margin:16px 0 0;color:#666;">
                <?= $escaper->escapeHtml(__('If it does not work,')) ?>
