            </p>
            <button type="button" id="asyntai-connect-btn" class="action-primary">
                <?= $escaper->escapeHtml(__('Get started')) ?>
            </button>
            <p style="margin:16px 0 0;color:#666;">
                <label for="asyntai-include-orders">
